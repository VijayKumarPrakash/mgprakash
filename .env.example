# ---------------------------------------------------------------------------
# M G Prakash Catering — environment variables
#
# Copy this file to .env.local and fill in the values:
#     cp .env.example .env.local
#
# .env.local is gitignored and must never be committed. This file is the
# committed reference — keep the keys in sync, but never put real values here.
#
# NEXT_PUBLIC_* is inlined into the client bundle at build time and is visible
# to anyone who opens devtools. Only put values here that are safe in public.
# Everything without that prefix stays server-side.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Dashboard → Project Settings → API

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon public" key. Safe to expose — it is constrained by row level security,
# which only permits SELECT on dishes and the read policies in schema.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key. SECRET. Bypasses row level security entirely.
# Used by npm run seed and by the order-submission route to write orders.
# Never prefix this with NEXT_PUBLIC_ and never paste it into client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Gmail SMTP via Nodemailer) --------------------------------------
# Sends the client confirmation (with PDF attached) and the business
# notification on order submission.

# The Gmail address orders are sent from and to.
GMAIL_USER=

# A Google App Password, NOT the account password. Requires 2-Step
# Verification, then: Google Account → Security → App passwords.
GMAIL_APP_PASSWORD=

# --- Site ------------------------------------------------------------------
# Absolute base URL. Two jobs:
#
#   1. The shareable /order/[id] link in emails and the PDF.
#   2. Every canonical URL, OpenGraph URL, sitemap entry and JSON-LD @id on the
#      site — see lib/seo.ts. This is the single origin all of them derive from.
#
# Because of (2) this MUST be set correctly in production. If it is wrong, every
# page tells Google it is a copy of somewhere else. It previously pointed at
# mgprakashcatering.com, a domain with no DNS record, which is exactly that bug.
#
# Set it to the origin the site is actually served from, with no trailing slash.
# Local:      http://localhost:3000
# Production: https://mgprakash.vercel.app   (change when a real domain is live)
NEXT_PUBLIC_SITE_URL=
